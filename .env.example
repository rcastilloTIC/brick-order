# Copy to .env and generate unique secrets BEFORE running
FLASK_ENV=production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_16_CHAR_PASSWORD
DEFAULT_USER_PASSWORD=REPLACE_WITH_UNIQUE_16_CHAR_PASSWORD
SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
SITE_ACCESS_PASSWORD=REPLACE_WITH_LONG_ACCESS_PASSPHRASE
PORT=5001

# Reference deployment: Caddy on the host -> 127.0.0.1:5001 (docker-compose.yml).
# Keep 1 there: otherwise every visitor shares the proxy's IP and the login /
# site-access rate limits become one global counter. Use 0 ONLY when clients
# connect directly to Gunicorn with no proxy at all.
TRUSTED_PROXY_COUNT=1

# REQUIRED in production: link to THIS edition's public corresponding source.
SOURCE_CODE_URL=https://github.com/REPLACE_OWNER/REPLACE_REPOSITORY
